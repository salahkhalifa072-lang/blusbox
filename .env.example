# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (§3). Works with any managed Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/blusbox"

# Canonical origin — drives canonicals, sitemap, hreflang and auth
# callbacks. Production is the apex; www.blusbox.nl redirects to it.
# Production: https://blusbox.nl
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Resend, for magic-link and transactional mail (§3)
AUTH_RESEND_KEY=""
MAIL_VAN="Blusbox <geen-antwoord@example.nl>"

# Stripe (§3) — iDEAL, Bancontact en kaart via hosted Checkout
# Publishable key: safe in the repo-adjacent env, it ships to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Secret key: NEVER paste this in chat or commit it. Dashboard ->
# Developers -> API keys -> Secret key. Starts with sk_test_
STRIPE_SECRET_KEY=""

# Filled automatically by `stripe listen` (see below). Starts with whsec_
STRIPE_WEBHOOK_SECRET=""
