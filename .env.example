# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (§3). Works with any managed Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/blusbox"

# Canonical origin, used for canonicals, sitemap and auth callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Resend, for magic-link and transactional mail (§3)
AUTH_RESEND_KEY=""
MAIL_VAN="Blusbox <geen-antwoord@example.nl>"

# Mollie (§3) — iDEAL is non-negotiable in NL
MOLLIE_API_KEY=""
