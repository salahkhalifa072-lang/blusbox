# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (§3). Works with any managed Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/blusbox"

# Canonical origin — drives canonicals, sitemap, hreflang and auth
# callbacks. Production is the apex; www.blusbox.nl redirects to it.
# Production: https://blusbox.nl
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# MailerSend (§3) — transactionele mail en de inloglink.
# Dashboard -> Integrations -> API tokens. Domein moet geverifieerd zijn,
# anders weigert MailerSend elke ontvanger buiten je eigen account.
MAILERSEND_API_TOKEN=""

# Afzender, in de vorm "Naam <adres@domein>". Het domein moet hetzelfde
# geverifieerde domein zijn als hierboven.
MAIL_VAN="Blusbox <info@blusbox.nl>"

# Adres dat in de mails staat als "antwoord hierop of neem contact op".
# Bewust hetzelfde adres als de afzender: een klant die op een bevestiging
# antwoordt komt dan uit waar hij denkt uit te komen. Vereist wel dat er
# MX-records staan, anders bounct dat antwoord.
MAIL_CONTACT="info@blusbox.nl"

# Stripe (§3) — iDEAL, Bancontact en kaart via hosted Checkout.
# Welke methodes worden aangeboden bepaalt het Stripe-dashboard, niet de code.
#
# Geen publishable key nodig: bij hosted Checkout sturen wij door naar de
# betaalpagina van Stripe en draait er geen Stripe-code in de browser.

# Secret key: NOOIT in een chat plakken of committen. Dashboard ->
# Developers -> API keys. sk_test_ voor test, sk_live_ voor productie.
STRIPE_SECRET_KEY=""

# Lokaal automatisch gevuld door `stripe listen`. In productie: het
# ondertekeningsgeheim van de webhook-bestemming. Begint met whsec_
STRIPE_WEBHOOK_SECRET=""

# Beschermt de dagelijkse herinneringsronde (/api/cron/herinneringen).
# Vercel Cron stuurt dit als "Authorization: Bearer <waarde>".
CRON_SECRET=""

# Verzendadres voor het maken van verzendlabels (niet in de repo)
VERZEND_STRAAT=
VERZEND_HUISNUMMER=
VERZEND_POSTCODE=
VERZEND_PLAATS=

# --- Affiliateprogramma ---
# Geen eigen variabelen nodig. De attributiecookie wordt ondertekend met een
# sleutel die uit AUTH_SECRET wordt afgeleid (met een eigen label, zodat die
# handtekening niet geldig is in het auth-systeem en omgekeerd). Dezelfde
# sleutel hasht het IP-adres van een klik; het adres zelf wordt niet bewaard.
#
# Commissiepercentage, attributieperiode, uitbetalingsdrempel en frequentie
# staan in de database en zijn door een beheerder te wijzigen onder
# /dashboard/affiliates. Ze horen niet in een omgevingsvariabele: dan is er
# een deploy nodig om een tarief aan te passen.

# --- Vindbaarheid in Google ---
# De code uit Search Console of Merchant Center bij "HTML-tag". Alleen het
# content-attribuut, niet de hele tag. Staat deze leeg, dan wordt er geen
# meta-tag gezet; dat is beter dan een lege of foute tag, want Google
# beschouwt zo'n tag als een mislukte verificatie.
#
# Zonder geverifieerd domein neemt Merchant Center de productfeed op
# /productfeed.xml niet in behandeling.
GOOGLE_SITE_VERIFICATION=

# --- Meting (Google Ads-conversies en GA4) ---
# Leeg laten = niets wordt geladen, geen toestemmingsbanner, en het
# cookiebeleid blijft zeggen dat wij niet meten. Vul je ze in, dan verandert
# dat alle drie tegelijk; zo kan de site nooit meten zonder het te vermelden.
#
# Conversie-id uit Google Ads, vorm AW-1234567890.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Alleen het deel ná de schuine streep van AW-123/AbC-D_efGh.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSIE_LABEL=
# Meet-id van GA4, vorm G-XXXXXXXXXX. Optioneel; Ads werkt ook zonder.
NEXT_PUBLIC_GA4_ID=
